<Window x:Class="CrashLens.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:CrashLens.App" Title="CrashLens">
 <Grid Background="#FF1E1F22" RequestedTheme="Dark" DataContext="{x:Bind ViewModel, Mode=OneWay}">
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
  <MenuBar Grid.Row="0" Background="#FF2B2D30"><MenuBarItem Title="File"><MenuFlyoutItem Text="Export Report" Command="{Binding ExportCommand}"/><MenuFlyoutItem Text="Export JSON"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Exit"/></MenuBarItem><MenuBarItem Title="View"><MenuFlyoutItem Text="Refresh" Command="{Binding RefreshCommand}"/><ToggleMenuFlyoutItem Text="Show Raw Log Pane" IsChecked="True"/><MenuFlyoutItem Text="Theme"/></MenuBarItem><MenuBarItem Title="Tools"><MenuFlyoutItem Text="Privacy Masking Options"/></MenuBarItem><MenuBarItem Title="Help"><MenuFlyoutItem Text="About CrashLens"/></MenuBarItem></MenuBar>
  <CommandBar Grid.Row="1" Background="#FF252526" DefaultLabelPosition="Right"><AppBarButton Icon="Refresh" Label="Refresh" Command="{Binding RefreshCommand}"/><AppBarSeparator/><ComboBox Width="145" SelectedIndex="1"><ComboBoxItem Content="Last 1 hour"/><ComboBoxItem Content="Last 24 hours"/><ComboBoxItem Content="Last 7 days"/><ComboBoxItem Content="Custom range..."/></ComboBox><TextBox Width="250" Margin="12,0" PlaceholderText="Search application, module, code"/><ComboBox Width="120" SelectedIndex="0"><ComboBoxItem Content="All events"/><ComboBoxItem Content="Crashes"/><ComboBoxItem Content="Hangs"/></ComboBox><AppBarButton Icon="Save" Label="Export" Command="{Binding ExportCommand}"/></CommandBar>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="440" MinWidth="300"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0" Background="#FF252526"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text=" RECENT CRASHES" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
    <ListView Grid.Row="1" ItemsSource="{Binding Crashes}" SelectedItem="{Binding SelectedCrash, Mode=TwoWay}" IsItemClickEnabled="True" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate x:DataType="local:CrashRow"><Grid Padding="10,8" BorderBrush="#FF3F4145" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="{Binding SeverityBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding Application}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding When}" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
   </Grid><GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="#FF3F4145"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="250" MinHeight="150"/></Grid.RowDefinitions>
    <ScrollViewer><StackPanel Padding="22,16" Spacing="18"><TextBlock Text="CRASH SUMMARY" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedCrash.ApplicationName}" FontSize="22" FontWeight="SemiBold"/><Grid ColumnSpacing="32"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:DetailSection Title="OVERVIEW" Grid.Column="0" Items="{Binding Overview}"/><local:DetailSection Title="APPLICATION" Grid.Column="1" Items="{Binding Application}"/></Grid><Grid ColumnSpacing="32"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:DetailSection Title="EXCEPTION" Grid.Column="0" Items="{Binding Exception}"/><local:DetailSection Title="FAULTING MODULE" Grid.Column="1" Items="{Binding Module}"/></Grid><TextBlock Text="POSSIBLE CAUSE" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Findings}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:FindingRow"><StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
    <GridSplitter Grid.Row="1" Height="5" ResizeDirection="Rows" Background="#FF3F4145"/><TabView Grid.Row="2" Margin="0" IsAddTabButtonVisible="False"><TabViewItem Header="Raw Event"><TextBox Text="{Binding SelectedCrash.RawMessage}" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0"/></TabViewItem><TabViewItem Header="XML"><TextBox Text="{Binding SelectedCrash.RawXml}" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0"/></TabViewItem><TabViewItem Header="Parsed Fields"><ListView ItemsSource="{Binding Overview}"/></TabViewItem><TabViewItem Header="Report Preview"><TextBox Text="{Binding ReportPreview}" FontFamily="Cascadia Mono" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0"/></TabViewItem></TabView>
   </Grid>
  </Grid><Grid Grid.Row="3" Background="#FF007ACC"><TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="10,0" FontSize="12"/><TextBlock Text="Application log · Local machine" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0" FontSize="12"/></Grid>
 </Grid>
</Window>
